{
	"name": "orca-cd-docs",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "node --run generate:api && vite dev",
		"build": "node --run generate:api && vite build",
		"start": "vite preview",
		"types:check": "node --run generate:api && fumadocs-mdx && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"generate:api": "node scripts/generate-api-reference.ts",
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.3",
		"@tanstack/react-start": "1.169.6",
		"@tanstack/start-static-server-functions": "1.167.44",
		"clsx": "^2.1.1",
		"fumadocs-core": "16.19.4",
		"fumadocs-mdx": "15.6.3",
		"fumadocs-openapi": "12.6.5",
		"fumadocs-ui": "16.19.4",
		"lucide-react": "^1.75.0",
		"lucide-static": "^1.75.0",
		"motion": "^14.14.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shiki": "^4.6.0",
		"swr": "^2.5.1",
		"tailwind-merge": "^3.7.0",
		"vite": "^8.3.8",
		"zbsearch": "^4.0.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.21.0"
}
